def get_stock(ticker):
    mapping = {
        "apple": "AAPL",
        "tesla": "TSLA",
        "nvidia": "NVDA",
        "microsoft": "MSFT",
        "google": "GOOGL",
    }
    symbol = mapping.get(ticker.lower(), ticker.upper())
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{urllib.parse.quote(symbol)}?range=1d&interval=1d"
    headers = {"User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X)"}
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, context=ctx) as resp:
            data = json.loads(resp.read().decode())
            meta = data["chart"]["result"][0]["meta"]
            symbol = meta["symbol"]
            price = meta["regularMarketPrice"]
            currency = meta.get("currency", "USD")
            prev_close = meta.get("chartPreviousClose", price)
            change = price - prev_close
            pct = (change / prev_close) * 100 if prev_close else 0

            return (
                f"📈 Stock: {symbol}\n"
                f"💵 Price: ${price:,.2f} {currency}\n"
                f"📊 Change: {change:+.2f} ({pct:+.2f}%)"
            )
    except Exception:
        return "no search results found, sorry for being inconvenient proto ai dual engine 2.0 is still a beta"


