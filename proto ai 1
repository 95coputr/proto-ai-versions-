def dual_engine_explain(query):
    global yt_mode_always_on

    words = query.strip().split()

    # IF THE USER ENTERS A SINGLE WORD/VOCABULARY TERM
    if len(words) == 1 and not query.startswith("/"):
        vocab = fetch_wikipedia_vocabulary(query)
        if vocab:
            return (
                f"📖 WIKIPEDIA VOCABULARY ENGINE\n"
                f"🔤 Term: {vocab['title']}\n"
                f"🏷️ Type: {vocab['description']}\n"
                f"📝 Meaning: {vocab['meaning']}"
            )

    # FOR MULTI-WORD QUERIES OR PHRASES
    deep_think_processor(query)

    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
        vocab_future = executor.submit(fetch_wikipedia_vocabulary, query)
        wiki_future = executor.submit(fetch_wikipedia_info, query)
        web_future = executor.submit(fetch_top_5_web_resources, query)

        vocab_res = vocab_future.result()
        wiki_res = wiki_future.result()
        web_res = web_future.result()

    if not wiki_res and not web_res and not vocab_res:
        return "no search results found, sorry for being inconvenient proto ai dual engine 2.0 is still a beta"

    output_lines = [f"🔍 PARALLEL SEARCH RESULTS FOR '{query}':\n"]

    if vocab_res:
        output_lines.append("📖 [WIKIPEDIA VOCABULARY DEFINITION]")
        output_lines.append(f"🔤 Term: {vocab_res['title']}")
        output_lines.append(f"📝 Meaning: {vocab_res['meaning']}\n")

    if wiki_res:
        output_lines.append("📚 [WIKIPEDIA OVERVIEW]")
        output_lines.append(f'"{wiki_res["summary"]}"')
        if wiki_res["link"]:
            output_lines.append(f"🔗 Link: {wiki_res['link']}\n")

    if web_res:
        output_lines.append("🌐 [SEARCH RESULTS & TRUSTED WEBSITES]")
        for res in web_res:
            output_lines.append(
                f"[{res['rank']}] {res['badge']} {res['snippet']}\n🔗 Link: {res['link']}\n"
            )

    if yt_mode_always_on:
        yt_videos = fetch_youtube_videos(query)
        if yt_videos:
            output_lines.append(f"\n{yt_videos}")

    return "\n".join(output_lines)


