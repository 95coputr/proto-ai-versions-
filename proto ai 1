def clean_text(raw_html):
    clean = re.sub(r"<[^>]+>", "", raw_html)
    clean = (
        clean.replace("&quot;", '"')
        .replace("&amp;", "&")
        .replace("&lt;", "<")
        .replace("&gt;", ">")
        .replace("&#x27;", "'")
        .replace("&#39;", "'")
    )
    return re.sub(r"\s+", " ", clean).strip()


def extract_math_expression(text):
    text_clean = text.lower()
    text_clean = (
        text_clean.replace("times", "*")
        .replace("x", "*")
        .replace("divided by", "/")
    )
    text_clean = text_clean.replace("plus", "+").replace("minus", "-")

    match = re.search(
        r"(\d+(?:\.\d+)?\s*[\+\-\*/]\s*\d+(?:\.\d+)?(?:\s*[\+\-\*/]\s*\d+(?:\.\d+)?)*)",
        text_clean,
    )
    if match:
        return match.group(1)
    return None


def fetch_nyt_top_news():
    url = "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, context=ctx) as resp:
            xml_data = resp.read().decode("utf-8")
            root = ET.fromstring(xml_data)

            items = root.findall("./channel/item")
            if not items:
                return "❌ Unable to parse New York Times news feed."

            output = ["📰 NEW YORK TIMES - TOP 10 HEADLINES\n"]
            for idx, item in enumerate(items[:10], 1):
                title = clean_text(item.findtext("title", "No Title"))
                desc = clean_text(item.findtext("description", "No Summary"))
                link = clean_text(item.findtext("link", ""))

                output.append(f"[{idx}] {title}")
                if desc:
                    output.append(f"    📝 {desc}")
                if link:
                    output.append(f"    🔗 Link: {link}")
                output.append("")

            return "\n".join(output).strip()
    except Exception as e:
        return f"❌ Error fetching New York Times news: {str(e)}"


def fetch_wikipedia_info(query):
    clean_query = re.sub(
        r"^(what|who|where|when|why|how)\s+(is|are|was|were|the|a|an)\s+",
        "",
        query,
        flags=re.IGNORECASE,
    ).strip()

    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }

    wiki_url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{urllib.parse.quote(clean_query)}"
    try:
        req = urllib.request.Request(wiki_url, headers=headers)
        with urllib.request.urlopen(req, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            extract = data.get("extract", "")
            page_url = data.get("content_urls", {}).get("desktop", {}).get("page", "")

            if extract and data.get("type") != "disambiguation":
                sentences = re.split(r"(?<=[.!?])\s+", extract)
                short_summary = " ".join(sentences[:3])
                return {"summary": short_summary, "link": page_url}
    except Exception:
        pass

    try:
        search_url = f"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch={urllib.parse.quote(query)}&format=json"
        req_search = urllib.request.Request(search_url, headers=headers)
        with urllib.request.urlopen(req_search, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            search_results = data.get("query", {}).get("search", [])
            if search_results:
                first_title = search_results[0]["title"]
                snippet = clean_text(search_results[0].get("snippet", ""))
                link = f"https://en.wikipedia.org/wiki/{urllib.parse.quote(first_title)}"
                return {"summary": snippet, "link": link}
    except Exception:
        pass

    return None


def fetch_wikipedia_vocabulary(term):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }

    url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{urllib.parse.quote(term)}"
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, context=ctx) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if data.get("type") == "disambiguation":
                return None
            title = data.get("title", term)
            description = data.get("description", "Vocabulary / Concept")
            extract = data.get("extract", "")
            
            if extract:
                return {
                    "title": title,
                    "description": description,
                    "meaning": extract
                }
    except Exception:
        pass
    return None


def fetch_top_5_web_resources(query):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            " (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        ),
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.5",
        "Content-Type": "application/x-www-form-urlencoded",
    }

    results = []

    try:
        data = urllib.parse.urlencode({"q": query}).encode("utf-8")
        req = urllib.request.Request(
            "https://html.duckduckgo.com/html/", data=data, headers=headers
        )

        with urllib.request.urlopen(req, context=ctx) as resp:
            html = resp.read().decode("utf-8", errors="ignore")

            raw_snippets = re.findall(
                r'<a class="result__snippet[^>]*>([\s\S]*?)</a>', html
            )
            raw_links = re.findall(
                r'<a class="result__url[^>]*href="([^"]+)"', html
            )

            for i in range(min(5, len(raw_snippets))):
                txt = clean_text(raw_snippets[i])
                lnk = raw_links[i] if i < len(raw_links) else "N/A"
                if lnk.startswith("//"):
                    lnk = f"https:{lnk}"

                is_trusted = any(domain in lnk.lower() for domain in TRUSTED_SITES)
                trusted_badge = "🛡️ [TRUSTED SITE]" if is_trusted else "🌐 [WEB RESOURCE]"

                if txt:
                    results.append(
                        {
                            "rank": len(results) + 1,
                            "snippet": txt,
                            "link": lnk,
                            "badge": trusted_badge,
                        }
                    )
    except Exception:
        pass

    return results


def fetch_youtube_videos(query):
    search_url = f"https://youtube.com/results?search_query={urllib.parse.quote(query)}"
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }

    try:
        req = urllib.request.Request(search_url, headers=headers)
        with urllib.request.urlopen(req, context=ctx) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
            video_ids = re.findall(r"\"videoId\":\"([^\"]+)\"", html)

            unique_ids = []
            for vid in video_ids:
                if vid not in unique_ids:
                    unique_ids.append(vid)
                if len(unique_ids) >= 3:
                    break

            if not unique_ids:
                return None

            video_links = [
                f"• https://youtube.com/watch?v={vid}" for vid in unique_ids
            ]
            return (
                f"📹 YOUTUBE VIDEO TUTORIALS / RESULTS FOR '{query}':\n"
                + "\n".join(video_links)
            )
    except Exception:
        return None


